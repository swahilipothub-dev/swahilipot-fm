# News content source:
#   sanity — Sanity Studio articles merged with the bundled local ones
#   remote — generic REST API (requires VITE_CMS_ENDPOINT)
#   unset  — bundled local articles only
VITE_CMS_PROVIDER=sanity

# Optional overrides — defaults match swahilipot-fm-cms/sanity.config.ts
# VITE_SANITY_PROJECT_ID=y0gzeipk
# VITE_SANITY_DATASET=production

# EmailJS — powers the Contact page form (create a free account at emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
# Optional — sends a confirmation email back to the visitor
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
