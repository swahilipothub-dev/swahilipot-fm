# News content source:
#   sanity — Sanity Studio articles merged with the bundled local ones
#   remote — generic REST API (requires VITE_CMS_ENDPOINT)
#   unset  — bundled local articles only
VITE_CMS_PROVIDER=sanity

# Optional overrides — defaults match swahilipot-fm-cms/sanity.config.ts
# VITE_SANITY_PROJECT_ID=y0gzeipk
# VITE_SANITY_DATASET=production
